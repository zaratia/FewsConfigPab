	<transformation id="InterpolateRainToGrid">
		<interpolationSpatial>
			<inverseDistance>				
				<inputVariable>
					<variableId>StationRain</variableId>
				</inputVariable>
				<minimumValue>0</minimumValue>
				<maximumValue>10000</maximumValue>
				<searchRadius>100000</searchRadius>
				<distanceGeoDatum>EPSG:3003</distanceGeoDatum>
				<inverseDistancePower>2</inverseDistancePower>
				<numberOfPoints>14</numberOfPoints>
				<outputVariable>
					<variableId>GridRain</variableId>
				</outputVariable>
			</inverseDistance>
		</interpolationSpatial>
	</transformation>
</transformationModule>
