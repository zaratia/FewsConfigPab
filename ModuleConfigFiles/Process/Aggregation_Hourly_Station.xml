<?xml version="1.0" encoding="UTF-8"?>
<transformationModule version="1.0" xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/transformationModule.xsd">
	<!--Aggregazione oraria-->
	<variable>
		<variableId>Pin</variableId>
		<timeSeriesSet>
		  <moduleInstanceId>Import_Station</moduleInstanceId>
		  <valueType>scalar</valueType>
		  <parameterId>P.obs</parameterId>
		  <locationSetId>arpav_stations</locationSetId>
		  <timeSeriesType>external historical</timeSeriesType>
		  <timeStep unit="minute" multiplier ="5"/>
		  <relativeViewPeriod unit="day" start="-365" end="0" startOverrulable="true" endOverrulable="true"/>
		  <readWriteMode>add originals</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>Pout</variableId>
		<timeSeriesSet>
		  <moduleInstanceId>Import_Station</moduleInstanceId>
		  <valueType>scalar</valueType>
		  <parameterId>P.obs</parameterId>
		  <locationSetId>arpav_stations</locationSetId>
		  <timeSeriesType>external historical</timeSeriesType>
		  <timeStep unit="hour" multiplier="1"/>
		  <relativeViewPeriod unit="day" start="-365" end="0" startOverrulable="true" endOverrulable="true"/>
		  <readWriteMode>add originals</readWriteMode>
		</timeSeriesSet>
	</variable>	
	<transformation id="AggregationHourlyP">
		<aggregation>
			<accumulative>
				<inputVariable>
					<variableId>Pin</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>Pout</variableId>
				</outputVariable>
			</accumulative>
		</aggregation>
	</transformation>
</transformationModule>
