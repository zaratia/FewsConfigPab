	<!--Transformations-->
	<transformation id="AggregationMonthP">
		<aggregation>
			<accumulative>
				<inputVariable>
					<variableId>Prec_grid_ECMWF</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>Pmon_grid_ECMWF</variableId>
				</outputVariable>
			</accumulative>
		</aggregation>
	</transformation>
	
	<transformation id="statistics ensemble median">
		<statisticsEnsemble>
            <percentileNonExceedence>
                <inputVariable>
                    <variableId>Pmon_grid_ECMWF</variableId>
                </inputVariable>
				<value>
				50
				</value>
                <outputVariable>
                    <variableId>Prec50_grid</variableId>
                </outputVariable>
            </percentileNonExceedence>
        </statisticsEnsemble>
    </transformation>	
	<transformation id="statistics ensemble 25">
		<statisticsEnsemble>
            <percentileNonExceedence>
                <inputVariable>
                    <variableId>Pmon_grid_ECMWF</variableId>
                </inputVariable>
				<value>25</value>
                <outputVariable>
                    <variableId>Prec25_grid</variableId>
                </outputVariable>
            </percentileNonExceedence>
        </statisticsEnsemble>
    </transformation>	
	<transformation id="statistics ensemble 75">
		<statisticsEnsemble>
            <percentileNonExceedence>
                <inputVariable>
                    <variableId>Pmon_grid_ECMWF</variableId>
