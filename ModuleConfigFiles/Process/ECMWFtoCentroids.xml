				<value>
				75
				</value>
                <outputVariable>
                    <variableId>Prec75_grid</variableId>
                </outputVariable>
            </percentileNonExceedence>
        </statisticsEnsemble>
    </transformation>	
	<transformation id="P50_interpolate_to_centroids">
		<interpolationSpatial>
			<closestDistance>
				<inputVariable>
					<variableId>Prec50_grid</variableId>
				</inputVariable>				
				<outputVariable>
					<variableId>Prec50_centroids</variableId>
				</outputVariable>
			</closestDistance>
		</interpolationSpatial>
	</transformation>	
