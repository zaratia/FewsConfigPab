<?xml version="1.0" encoding="UTF-8"?>
<timeSeriesImportRun xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews
http://fews.wldelft.nl/schemas/version1.0/timeSeriesImportRun.xsd">
	<import>
		<general>
			<importType>generalCSV</importType>
			<folder>$IMPORT_FOLDER$/CSV/Test</folder>
			<fileNamePatternFilter>*.csv</fileNamePatternFilter>
			<failedFolder>$IMPORT_FAILED_FOLDER$</failedFolder>
			<backupFolder>$IMPORT_BACKUP_FOLDER$</backupFolder>
			<table>
				<locationColumn name="loc_id"/>
				<parameterColumn name="var"/>
				<dateTimeColumn name="time" pattern="yyyy-MM-dd"/>
				<!--timeColumn name="ORA" pattern="HH:mm"/-->
				<!--valueColumn name="Valore" unit="mm"/-->
				<valueColumn name="val"/>
			</table>
			<idMapId>IdImportTimeseriesCSV</idMapId>
			<unitConversionsId>ImportUnitConversions</unitConversionsId>
			<importTimeZone>
				<timeZoneOffset>+00:00</timeZoneOffset>
			</importTimeZone>
			<dataFeedId>Import.CSV</dataFeedId>
			<expiryTime unit="day" multiplier="365"/>
			<skipFirstLinesCount>0</skipFirstLinesCount>
		</general>
		<timeSeriesSet>
			<moduleInstanceId>Import_timeseries</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>PET.obs</parameterId>
			<locationSetId>centroidi_distretti</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep unit="day" multiplier="1"/>
			<readWriteMode>add originals</readWriteMode>			
			<synchLevel>1</synchLevel>
		</timeSeriesSet>
        <timeSeriesSet>
			<moduleInstanceId>Import_timeseries</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>STO.obs</parameterId>
			<locationSetId>centroidi_distretti</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep unit="day" multiplier="1"/>
			<readWriteMode>add originals</readWriteMode>			
			<synchLevel>1</synchLevel>
		</timeSeriesSet>
	</import>
</timeSeriesImportRun>
