			<softMax constantLimit="50"/>
		</extremeValues>
		<timeSeriesSet>
			<moduleInstanceId>Interpolate_Temper</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>T.obs</parameterId>
			<locationId>LEB500</locationId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep unit="day" multiplier="1"/>
			<readWriteMode>add originals</readWriteMode>
		</timeSeriesSet>
	</validationRuleSet-->
</validationRuleSets>
