<?xml version="1.0" encoding="UTF-8"?>
<locationSets version="1.1" xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/locationSets.xsd">
	
	<locationSet id="bz_stations">
		<csvFile>
			<file>bz_stations.csv</file>
			<geoDatum>WGS 1984</geoDatum>
			<id>%id%</id>
			<name>%nome%</name>
			<x>%lon%</x>
			<y>%lat%</y>
			<z>%elev%</z>		
			<attribute id="parameter">
				<text>%parameter%</text>
			</attribute>	
		</csvFile>
	</locationSet>	

	<locationSet id="bz_centroids_topo60">
		<csvFile>
			<file>aa250m_centroids_topo60_202204.csv</file>
			<geoDatum>UTM32N</geoDatum>
			<id>CEN_%idba%</id>
			<name>%descr%</name>
			<x>%coord_x%</x>
			<y>%coord_y%</y>
			<z>%elev%</z>	
		</csvFile>
	</locationSet>

	<locationSet id="bz_grad_centroids_topo60">
		<csvFile>
			<file>aa250m_centroid_gradients_topo60_202204.csv</file>
			<geoDatum>UTM32N</geoDatum>
			<id>GRA_%idlapse%</id>
			<name>%descr%</name>
			<x>%coord_x%</x>
			<y>%coord_y%</y>
			<z>%elev%</z>	
		</csvFile>
	</locationSet>

	<locationSet id="arpav_stations">
		<csvFile>
			<file>meteo_idro_arpav_stations.csv</file>
			<geoDatum>WGS 1984</geoDatum>
			<id>%Codice_SIRAV%</id>
			<name>%nome%</name>
			<x>%Epsg4258_Lon%</x>
			<y>%Epsg4258_Lat%</y>
			<z>%Quota%</z>		
		</csvFile>
	</locationSet>
	
	<locationSet id="centroidi_distretti">
		<csvFile>
			<file>centroidi_bacini.csv</file>
			<geoDatum>WGS 1984</geoDatum>
			<id>B%id%</id>
			<name>%D_BAC_1%</name>
			<x>%lon%</x>
			<y>%lat%</y>
			<!--toolTip>
			Nome: %D_BAC_1%
			Area m^2: %Area%
			</toolTip-->
		</csvFile>
	</locationSet>
	
	<locationSet id="canali">
		<csvFile>
			<file>channels.csv</file>
			<geoDatum>WGS 1984</geoDatum>
			<id>C%id%</id>
			<name>Canale %id%</name>
			<x>%lon%</x>
			<y>%lat%</y>
			<!--toolTip>
			Nome: %D_BAC_1%
			Area m^2: %Area%
			</toolTip-->
		</csvFile>
	</locationSet>
	
	<locationSet id="derivazioni">
		<csvFile>
			<file>derivazioni.csv</file>
			<geoDatum>WGS 1984</geoDatum>
			<id>D%id%</id>
			<!--name>Derivazione %id%</name-->
			<name>%Nome%</name>
			<x>%lon%</x>
			<y>%lat%</y>
			<!--toolTip>
			Nome: %D_BAC_1%
			Area m^2: %Area%
			</toolTip-->
		</csvFile>
	</locationSet>
	
	<locationSet id="idrovore">
		<csvFile>
			<file>dewatering.csv</file>
			<geoDatum>WGS 1984</geoDatum>
			<id>P%id%</id>
			<name>Idrovora %id%</name>
			<x>%lon%</x>
			<y>%lat%</y>
			<!--toolTip>
			Nome: %D_BAC_1%
			Area m^2: %Area%
			</toolTip-->
		</csvFile>
	</locationSet>
</locationSets>
