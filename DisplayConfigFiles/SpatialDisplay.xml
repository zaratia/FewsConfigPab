	<gridPlotGroup id="GFS" name="GFS Forecasts">
		<gridPlot id="Rain_forecast_nwp" name="Rainfall Forecast">
			<dataLayer>
				<timeSeriesSet>
					<moduleInstanceId>Import_GFS_Server</moduleInstanceId>
					<valueType>grid</valueType>
					<parameterId>P.forecast</parameterId>
					<locationId>GFS</locationId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep multiplier="3" unit="hour"/>
					<readWriteMode>read complete forecast</readWriteMode>
				</timeSeriesSet>
			</dataLayer>
			<movingAccumulationTimeSpan unit="hour" multiplier="6"/>
			<movingAccumulationTimeSpan unit="hour" multiplier="12"/>
			<movingAccumulationTimeSpan unit="day" multiplier="1"/>
			<movingAccumulationTimeSpan unit="day" multiplier="2"/>
			<movingAccumulationTimeSpan unit="day" multiplier="3"/>
			<contourLinesColor>black</contourLinesColor>
		</gridPlot>
		<gridPlot id="Wind_forecast_nwp" name="Wind Forecast">
			<dataLayer>
				<arrowColor>white</arrowColor>
				<arrowSymbol>flow</arrowSymbol>
				<multipleArrowsPerValue>false</multipleArrowsPerValue>
				<uTimeSeriesSet>
					<moduleInstanceId>Import_GFS_Server</moduleInstanceId>
					<valueType>grid</valueType>
					<parameterId>WS.u.forecast</parameterId>
					<locationId>GFS</locationId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep multiplier="3" unit="hour"/>
					<readWriteMode>read complete forecast</readWriteMode>
				</uTimeSeriesSet>
				<vTimeSeriesSet>
					<moduleInstanceId>Import_GFS_Server</moduleInstanceId>
					<valueType>grid</valueType>
					<parameterId>WS.v.forecast</parameterId>
					<locationId>GFS</locationId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep multiplier="3" unit="hour"/>
					<readWriteMode>read complete forecast</readWriteMode>
				</vTimeSeriesSet>
				<uvAmplitudeParameterId>Wind.speed</uvAmplitudeParameterId>
				<uvDirectionParameterId>Wind.dir</uvDirectionParameterId>
			</dataLayer>
			<dataLayer>
				<onlyContourLines>true</onlyContourLines>
				<timeSeriesSet>
					<moduleInstanceId>Import_GFS_Server</moduleInstanceId>
					<valueType>grid</valueType>
					<parameterId>Pressure.msl</parameterId>
					<locationId>GFS</locationId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep multiplier="3" unit="hour"/>
					<readWriteMode>read complete forecast</readWriteMode>
					<divider>100</divider>
				</timeSeriesSet>
			</dataLayer>
			<movieFrameDurationMillis>300</movieFrameDurationMillis>
			<hideLastValueCheckBox>true</hideLastValueCheckBox>
			<barLegend>
				<position>right</position>
				<width>50</width>
				<length>400</length>
				<labelsInside>true</labelsInside>
			</barLegend>
			<classBreaksId>Class.Wind.Speed</classBreaksId>
			<contourLinesColor>gray30</contourLinesColor>
		</gridPlot>
