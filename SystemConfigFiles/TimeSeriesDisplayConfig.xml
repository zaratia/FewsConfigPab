		<classBreaks id="Class.Wind.Speed">
			<missingValueColor>white</missingValueColor>
			<missingValueOpaquenessPercentage>25</missingValueOpaquenessPercentage>
			<belowRangeColor>black</belowRangeColor>
			<belowRangeOpaquenessPercentage>25</belowRangeOpaquenessPercentage>
			<aboveRangeColor>maroon3</aboveRangeColor>
			<aboveRangeOpaquenessPercentage>25</aboveRangeOpaquenessPercentage>
			<unitVisible>true</unitVisible>
			<color color="0000A8" lowerValue="0" symbolSize="10" opaquenessPercentage="25"/>
			<color color="0000E6" lowerValue="1" symbolSize="11" opaquenessPercentage="25"/>
			<color color="004DFF" lowerValue="2" symbolSize="12" opaquenessPercentage="25"/>
			<color color="00B3FF" lowerValue="4" symbolSize="14" opaquenessPercentage="25"/>
			<color color="1AFFE5" lowerValue="6" symbolSize="15" opaquenessPercentage="25"/>
			<color color="80FF80" lowerValue="8" symbolSize="16" opaquenessPercentage="25"/>
			<color color="E6FF19" lowerValue="12" symbolSize="21" opaquenessPercentage="25"/>
			<color color="FFB200" lowerValue="16" symbolSize="26" opaquenessPercentage="25"/>
			<color color="FF4C00" lowerValue="20" symbolSize="31" opaquenessPercentage="25"/>
			<color color="E50000" lowerValue="25" symbolSize="36" opaquenessPercentage="25"/>
			<color color="A80000" lowerValue="30" symbolSize="41" opaquenessPercentage="25"/>
		</classBreaks>
	</classBreaks>
